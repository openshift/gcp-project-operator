{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>openshift/boilerplate//.github/renovate.json"
  ],
  "dockerfile": {
    "includePaths": [
      "build/Dockerfile",
      "build/Dockerfile.hummingbird"
    ],
    "packageRules": [
      {
        "description": "Review Hummingbird runtime digest updates before merging",
        "matchPackageNames": [
          "registry.access.redhat.com/hi/go"
        ],
        "matchUpdateTypes": [
          "digest"
        ],
        "automerge": false,
        "platformAutomerge": false
      }
    ]
  }
}
